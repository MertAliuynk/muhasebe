datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum UserRole {
    ADMIN
    MANAGER
    DOCTOR
}

enum PaymentType {
    BANK_TRANSFER
    CREDIT_CARD
    CASH
}

enum AuditAction {
    CREATE
    UPDATE
    DELETE
    RESTORE
}

model AuditLog {
    id         String      @id @default(cuid())
    action     AuditAction
    entityType String
    entityId   String
    userId     String
    createdAt  DateTime    @default(now())

    // Relations
    user User @relation(fields: [userId], references: [id])

    // Indexes
    @@index([entityType, entityId])
    @@index([userId])
    @@index([createdAt])
}

model User {
    id        String    @id @default(cuid())
    username  String    @unique
    password  String
    name      String
    role      UserRole
    imagePath String?
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    // Relations
    doctor        Doctor?
    branchManager Branch?
    company       Company?
    auditLogs     AuditLog[]

    // Indexes
    @@index([role])
    @@index([username])
    @@index([isDeleted])
}

model Company {
    id        String    @id @default("single_company")
    name      String
    address   String
    phone     String
    taxNumber String?
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    // Relations
    branches Branch[]
    ceoId    String   @unique
    ceo      User     @relation(fields: [ceoId], references: [id])

    // Indexes
    @@index([isDeleted])
    @@index([name])
}

model Branch {
    id        String    @id @default(cuid())
    name      String
    address   String?
    phone     String?
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    // Relations
    companyId String
    company   Company @relation(fields: [companyId], references: [id])

    managerId String @unique
    manager   User   @relation(fields: [managerId], references: [id])

    doctors  Doctor[]
    patients Patient[]

    branchExpenses BranchExpense[]
    doctorExpenses DoctorExpense[]

    branchPayments  BranchPayment[]
    patientPayments PatientPayment[]

    // Indexes
    @@index([companyId])
    @@index([managerId])
    @@index([isDeleted])
    @@index([name])
}

model Doctor {
    id          String    @id @default(cuid())
    specialty   String?
    tcNo        String?
    phoneNumber String?
    birthDate   DateTime?
    commission  Int
    isDeleted   Boolean   @default(false)
    deletedAt   DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    // Relations
    userId   String          @unique
    user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    branchId String
    branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
    patients Patient[]
    expenses DoctorExpense[]
    incomes  DoctorIncome[]

    // Indexes
    @@index([userId])
    @@index([branchId])
    @@index([isDeleted])
    @@index([specialty])
}

model Patient {
    id        String    @id @default(cuid())
    name      String
    phone     String?
    tcNo      String?
    birthDate DateTime?
    address   String?
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    // Relations
    branchId     String
    branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
    paymentPlans PatientPaymentPlan[]
    doctors      Doctor[]
    notes        String[]
    payments     PatientPayment[]

    // Indexes
    @@index([branchId])
    @@index([isDeleted])
    @@index([name])
}

model PatientPaymentPlan {
    id               String    @id @default(cuid())
    totalAmount      Int
    originalAmount   Int
    interestRate     Int
    remainingAmount  Int
    paidAmount       Int
    installmentCount Int
    startDate        DateTime
    isApproved       Boolean   @default(false)
    isCompleted      Boolean   @default(false)
    note             String?
    isDeleted        Boolean   @default(false)
    deletedAt        DateTime?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    // Relations
    patientId    String
    patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
    installments Installment[]

    // Indexes
    @@index([patientId])
    @@index([isDeleted])
    @@index([isApproved])
    @@index([isCompleted])
}

model PatientPayment {
    id          String      @id @default(cuid())
    amount      Int
    paymentType PaymentType
    paymentDate DateTime    @default(now())
    note        String?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    // Relations
    patient   Patient? @relation(fields: [patientId], references: [id])
    patientId String?
    branchId  String
    branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

    // Indexes
    @@index([paymentDate])
}

model DoctorIncome {
    id          String      @id @default(cuid())
    amount      Int
    paymentType PaymentType
    paymentDate DateTime    @default(now())
    note        String?
    commission  Int
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    // Relations
    doctorId String
    doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

    // Indexes
    @@index([paymentDate])
}

model BranchPayment {
    id          String      @id @default(cuid())
    amount      Int
    paymentType PaymentType
    paymentDate DateTime    @default(now())
    note        String?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    // Relations
    branchId String
    branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

    // Indexes
    @@index([paymentDate])
}

model Installment {
    id              String    @id @default(cuid())
    number          Int
    amount          Int
    dueDate         DateTime
    paidAmount      Int       @default(0)
    remainingAmount Int       @default(0)
    isCompleted     Boolean   @default(false)
    lastPaymentDate DateTime?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    //Relations
    paymentPlanId String
    paymentPlan   PatientPaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

    // Indexes
    @@index([paymentPlanId])
    @@index([number])
}

model ExpenseType {
    id          String    @id @default(cuid())
    name        String
    description String?
    isDeleted   Boolean   @default(false)
    deletedAt   DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    // Relations
    branchExpenses BranchExpense[]
    doctorExpenses DoctorExpense[]

    // Indexes
    @@index([isDeleted])
    @@index([name])
}

model BranchExpense {
    id          String    @id @default(cuid())
    amount      Int
    description String?
    isDeleted   Boolean   @default(false)
    deletedAt   DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    // Relations
    expenseTypeId String
    expenseType   ExpenseType @relation(fields: [expenseTypeId], references: [id], onDelete: Cascade)
    branchId      String
    branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

    // Indexes
    @@index([expenseTypeId])
    @@index([branchId])
    @@index([isDeleted])
}

model DoctorExpense {
    id          String    @id @default(cuid())
    amount      Int
    description String?
    isDeleted   Boolean   @default(false)
    deletedAt   DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    // Relations
    expenseTypeId String
    expenseType   ExpenseType @relation(fields: [expenseTypeId], references: [id], onDelete: Cascade)
    doctorId      String
    doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
    branch        Branch      @relation(fields: [branchId], references: [id])
    branchId      String

    // Indexes
    @@index([doctorId])
    @@index([isDeleted])
}
