datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum UserRole {
    ADMIN
    MANAGER
    DOCTOR
}

enum PaymentType {
    BANK_TRANSFER
    CREDIT_CARD
    CASH
}

enum AuditAction {
    CREATE
    UPDATE
    DELETE
    RESTORE
}

model AuditLog {
    id         String      @id @default(cuid())
    action     AuditAction
    entityType String
    entityId   String
    userId     String
    createdAt  DateTime    @default(now())

    // Relations
    user User @relation(fields: [userId], references: [id])

    // Indexes
    @@index([entityType, entityId])
    @@index([userId])
    @@index([createdAt])
}

model User {
    id        String    @id @default(cuid())
    username  String    @unique
    password  String
    name      String
    role      UserRole
    imagePath String?
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    // Relations
    doctor        Doctor?
    branchManager Branch?
    company       Company?
    auditLogs     AuditLog[]

    // Indexes
    @@index([role])
    @@index([username])
    @@index([isDeleted])
}

model Company {
    id        String    @id @default("single_company")
    name      String
    address   String
    phone     String
    taxNumber String?
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    branches Branch[]
    ceoId    String   @unique
    ceo      User     @relation(fields: [ceoId], references: [id])

    // Indexes
    @@index([isDeleted])
    @@index([name])
}

model Branch {
    id        String    @id @default(cuid())
    name      String
    address   String?
    phone     String?
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    // Relations
    companyId String
    company   Company   @relation(fields: [companyId], references: [id])
    managerId String    @unique
    manager   User      @relation(fields: [managerId], references: [id])
    doctors   Doctor[]
    expenses  Expense[]
    patients  Patient[]

    // Indexes
    @@index([companyId])
    @@index([managerId])
    @@index([isDeleted])
    @@index([name])
}

model Doctor {
    id          String    @id @default(cuid())
    specialty   String?
    tcNo        String?
    phoneNumber String?
    birthDate   DateTime?
    isDeleted   Boolean   @default(false)
    deletedAt   DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    // Relations
    userId     String      @unique
    user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    branchId   String
    branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
    patients   Patient[]
    expenses   Expense[]
    treatments Treatment[] // Doktorun yaptığı tedaviler

    // Indexes
    @@index([userId])
    @@index([branchId])
    @@index([isDeleted])
    @@index([specialty])
}

model Patient {
    id        String    @id @default(cuid())
    name      String
    phone     String?
    tcNo      String?
    birthDate DateTime?
    address   String?
    notes     String[]
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    // Relations
    doctorId    String?
    doctor      Doctor?              @relation(fields: [doctorId], references: [id])
    branchId    String
    branch      Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
    treatments  Treatment[]
    paymentPlan PatientPaymentPlan[]

    // Indexes
    @@index([doctorId])
    @@index([branchId])
    @@index([isDeleted])
    @@index([name])
}

model Treatment {
    id             String    @id @default(cuid())
    name           String
    originalAmount Decimal // İlk fiyat (50.000 TL)
    totalAmount    Decimal // Faizli toplam tutar (60.000 TL)
    installments   Int // Taksit sayısı
    interestRate   Decimal // Faiz oranı
    doctorRate     Decimal // Doktor yüzdesi (örn: 30.00)
    startDate      DateTime  @default(now())
    endDate        DateTime?
    isDeleted      Boolean   @default(false)
    deletedAt      DateTime?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt

    // Relations
    patientId String
    patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
    doctorId  String
    doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
    payments  Payment[]

    // Indexes
    @@index([patientId])
    @@index([doctorId])
    @@index([isDeleted])
    @@index([startDate, endDate])
}

model Payment {
    id                String      @id @default(cuid())
    amount            Decimal
    paymentType       PaymentType
    paymentDate       DateTime    @default(now())
    installmentNumber Int // Hangi takside yapıldığı (1-6 arası)
    isDeleted         Boolean     @default(false)
    deletedAt         DateTime?
    createdAt         DateTime    @default(now())
    updatedAt         DateTime    @updatedAt

    // Relations
    treatmentId String
    treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

    // Indexes
    @@index([treatmentId])
    @@index([paymentType])
    @@index([paymentDate])
    @@index([isDeleted])
    @@index([installmentNumber])
}

model PatientPaymentPlan {
    id                   String    @id @default(cuid())
    totalAmount          Int
    installmentCount     Int
    interestRate         Int       @default(0)
    firstInstallmentDate DateTime
    installments         Json[]
    isDeleted            Boolean   @default(false)
    deletedAt            DateTime?
    createdAt            DateTime  @default(now())
    updatedAt            DateTime  @updatedAt

    // Relations
    patientId String
    patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

    // Indexes
    @@index([patientId])
    @@index([isDeleted])
    @@index([firstInstallmentDate])
}

model ExpenseType {
    id          String    @id @default(cuid())
    name        String
    description String?
    isDeleted   Boolean   @default(false)
    deletedAt   DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    // Relations
    expenses Expense[]

    // Indexes
    @@index([isDeleted])
    @@index([name])
}

model Expense {
    id          String    @id @default(cuid())
    amount      Int
    description String?
    isDeleted   Boolean   @default(false)
    deletedAt   DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    // Relations
    expenseTypeId String
    expenseType   ExpenseType @relation(fields: [expenseTypeId], references: [id], onDelete: Cascade)
    branchId      String
    branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
    doctorId      String?
    doctor        Doctor?     @relation(fields: [doctorId], references: [id], onDelete: Cascade)

    // Indexes
    @@index([expenseTypeId])
    @@index([branchId])
    @@index([doctorId])
    @@index([isDeleted])
}
