datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum UserRole {
    ADMIN
    MANAGER
    DOCTOR
    SECRETARY
}

enum PaymentType {
    BANK_TRANSFER
    CREDIT_CARD
    CASH
}

enum AuditAction {
    CREATE
    UPDATE
    DELETE
    RESTORE
}

model AuditLog {
    id         String      @id @default(cuid())
    action     AuditAction
    entityType String
    entityId   String
    userId     String
    createdAt  DateTime    @default(now())

    user User @relation(fields: [userId], references: [id])

    @@index([entityType, entityId])
    @@index([userId])
    @@index([createdAt])
}

model User {
    id        String    @id @default(cuid())
    username  String    @unique
    password  String
    name      String
    role      UserRole
    imagePath String?
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    doctor        Doctor?
    secretary     Secretary?
    branchManager Branch?
    company       Company?
    auditLogs     AuditLog[]

    @@index([role])
    @@index([username])
    @@index([isDeleted])
}

model Company {
    id        String    @id @default("single_company")
    name      String
    address   String
    phone     String
    taxNumber String?
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    branches Branch[]
    ceoId    String   @unique
    ceo      User     @relation(fields: [ceoId], references: [id])

    @@index([isDeleted])
    @@index([name])
}

model Branch {
    id        String    @id @default(cuid())
    name      String
    address   String?
    phone     String?
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    companyId String
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    managerId String @unique
    manager   User   @relation(fields: [managerId], references: [id], onDelete: Cascade)

    doctors  Doctor[]
    patients Patient[]

    branchExpenses BranchExpense[]
    doctorExpenses DoctorExpense[]

    branchPayments  BranchPayment[]
    patientPayments PatientPayment[]
    cashReports     CashReport[]
    Secretary       Secretary[]

    @@index([companyId])
    @@index([managerId])
    @@index([isDeleted])
    @@index([name])
}

model Doctor {
    id          String    @id @default(cuid())
    specialty   String?
    tcNo        String?
    phoneNumber String?
    birthDate   DateTime?
    commission  Int
    isDeleted   Boolean   @default(false)
    deletedAt   DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    userId        String               @unique
    user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
    branchId      String
    branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
    patients      Patient[]
    expenses      DoctorExpense[]
    incomes       DoctorIncome[]
    paymentShares DoctorPaymentShare[]

    @@index([userId])
    @@index([branchId])
    @@index([isDeleted])
    @@index([specialty])
}

model Secretary {
    id          String    @id @default(cuid())
    phoneNumber String?
    isDeleted   Boolean   @default(false)
    deletedAt   DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    userId   String @unique
    user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    branchId String
    branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([branchId])
    @@index([isDeleted])
}

model Patient {
    id        String    @id @default(cuid())
    name      String
    phone     String?
    tcNo      String?
    birthDate DateTime?
    address   String?
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    branchId     String
    branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
    paymentPlans PatientPaymentPlan[]
    doctors      Doctor[]
    notes        String[]
    payments     PatientPayment[]

    @@index([branchId])
    @@index([isDeleted])
    @@index([name])
}

model PatientPaymentPlan {
    id               String    @id @default(cuid())
    totalAmount      Int
    originalAmount   Int
    interestRate     Int
    remainingAmount  Int
    paidAmount       Int
    installmentCount Int
    startDate        DateTime
    isApproved       Boolean   @default(false)
    isCompleted      Boolean   @default(false)
    note             String?
    isDeleted        Boolean   @default(false)
    deletedAt        DateTime?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    patientId       String
    patient         Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
    installments    Installment[]
    doctorShares    DoctorPaymentShare[]
    patientPayments PatientPayment[]

    @@index([patientId])
    @@index([isDeleted])
    @@index([isApproved])
    @@index([isCompleted])
}

model PatientPayment {
    id          String      @id @default(cuid())
    amount      Int
    paymentType PaymentType
    paymentDate DateTime    @default(now())
    note        String?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    patient       Patient?            @relation(fields: [patientId], references: [id])
    patientId     String?
    branchId      String
    branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
    paymentPlan   PatientPaymentPlan? @relation(fields: [paymentPlanId], references: [id])
    paymentPlanId String?
    doctorIncomes DoctorIncome[]

    @@index([paymentDate])
    @@index([branchId, createdAt])
}

model DoctorIncome {
    id          String      @id @default(cuid())
    amount      Int
    paymentType PaymentType
    paymentDate DateTime    @default(now())
    commission  Int
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    doctorId  String
    doctor    Doctor          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
    payment   PatientPayment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
    paymentId String?

    @@index([paymentDate])
}

model DoctorPaymentShare {
    id              String   @id @default(cuid())
    totalAmount     Int
    paidAmount      Int      @default(0)
    remainingAmount Int
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    doctorId      String
    doctor        Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
    paymentPlanId String
    paymentPlan   PatientPaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

    @@index([doctorId])
    @@index([paymentPlanId])
}

model BranchPayment {
    id          String      @id @default(cuid())
    amount      Int
    paymentType PaymentType
    paymentDate DateTime    @default(now())
    note        String?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    branchId String
    branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

    @@index([paymentDate])
    @@index([branchId, createdAt])
}

model Installment {
    id              String    @id @default(cuid())
    number          Int
    amount          Int
    dueDate         DateTime
    paidAmount      Int       @default(0)
    remainingAmount Int       @default(0)
    isCompleted     Boolean   @default(false)
    lastPaymentDate DateTime?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    paymentPlanId String
    paymentPlan   PatientPaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

    @@index([paymentPlanId])
    @@index([number])
}

model ExpenseType {
    id          String    @id @default(cuid())
    name        String
    description String?
    isDeleted   Boolean   @default(false)
    deletedAt   DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    branchExpenses BranchExpense[]
    doctorExpenses DoctorExpense[]

    @@index([isDeleted])
    @@index([name])
}

model BranchExpense {
    id          String      @id @default(cuid())
    amount      Int
    paymentType PaymentType
    description String?
    isDeleted   Boolean     @default(false)
    deletedAt   DateTime?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    expenseTypeId String
    expenseType   ExpenseType @relation(fields: [expenseTypeId], references: [id], onDelete: Cascade)
    branchId      String
    branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

    @@index([expenseTypeId])
    @@index([branchId])
    @@index([isDeleted])
    @@index([branchId, createdAt])
}

model DoctorExpense {
    id          String      @id @default(cuid())
    amount      Int
    paymentType PaymentType
    description String?
    isDeleted   Boolean     @default(false)
    deletedAt   DateTime?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    expenseTypeId String
    expenseType   ExpenseType @relation(fields: [expenseTypeId], references: [id], onDelete: Cascade)
    doctorId      String
    doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
    branch        Branch      @relation(fields: [branchId], references: [id])
    branchId      String

    @@index([doctorId])
    @@index([isDeleted])
    @@index([branchId, createdAt])
}

model CashReport {
    id String @id @default(cuid())

    cashIncome  Int
    cashExpense Int
    cashBalance Int

    cardIncome  Int
    cardExpense Int
    cardBalance Int

    transferIncome  Int
    transferExpense Int
    transferBalance Int

    totalIncome  Int
    totalExpense Int
    totalBalance Int

    branchId String
    branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@index([branchId])
    @@index([branchId, createdAt])
}
